datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Genre {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  movies    Movie[] // Implicit Many-to-Many
  createdAt DateTime @default(now())
}

model Movie {
  id              Int         @id @default(autoincrement())
  clientRequestId String?     @db.Uuid
  userId          Int
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          WatchStatus @default(TO_WATCH)
  rating          Int?
  trailerUrl      String?
  genres          Genre[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([userId, status])
}

enum WatchStatus {
  TO_WATCH
  WATCHED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  movies       Movie[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
